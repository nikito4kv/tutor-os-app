# --- Supabase (Postgres + Auth + Storage) ---
# From Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the client. Used by trusted server actions / scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public base URL, used to build student share links (e.g. https://app.example.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Resend) — leave empty locally; emails are mocked until a key is set ---
# Key from resend.com (API Keys). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="tutorOS <noreply@tutor-os.online>"

# --- Telegram bot — leave empty locally; notifications are mocked until a token is set ---
# Token from @BotFather. Username is the bot's @name (without @), used to build deep links.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secret you pass to setWebhook; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Secret the external cron (cron-job.org / GitHub Actions) sends to /api/cron/notifications.
CRON_SECRET=

# --- Video (Daily.co) — deferred slice 8, leave empty for the accounting-core MVP ---
DAILY_API_KEY=
